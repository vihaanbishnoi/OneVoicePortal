# Required PostgreSQL connection URL. SQLite is intentionally not supported.
DATABASE_URL=postgresql+psycopg2://onevoice:change-me@localhost:5432/onevoice
SECRET_KEY=replace-with-a-long-random-secret

# First HR admin account, created only when the email does not yet exist.
ADMIN_NAME=HR Administrator
ADMIN_EMAIL=hr-admin@example.com
ADMIN_PASSWORD=change-this-before-deployment

# Used only by the scheduler that calls POST /api/jobs/reminders.
JOB_KEY=replace-with-a-second-long-random-secret
