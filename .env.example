# Required PostgreSQL connection URL. SQLite is intentionally not supported.
DATABASE_URL=postgresql+psycopg2://onevoice:onevoice-local@127.0.0.1:15432/onevoice
SECRET_KEY=replace-with-a-long-random-secret

# Prototype credentials. The only administrator email is vihaan4263@gmail.com.
# Accounts are created at startup; password changes update hashes on restart.
# Set the agreed passwords in your untracked .env or hosting environment.
ADMIN_NAME=Vihaan
ADMIN_PASSWORD=replace-with-admin-password
HR_TEAM_PASSWORD=replace-with-shared-team-password
ALLOW_SHARED_HR_LOGIN=0
DEMO_ENABLED=1
PUBLIC_DEPLOYMENT=0
FRONTEND_URL=http://localhost:5173

# Private conversations use a local model; demo conversations use OpenAI.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_CONTEXT=8192
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
DEMO_AI_SESSION_LIMIT=5
DEMO_AI_DAILY_LIMIT=50
DEMO_DAILY_SESSION_LIMIT=500
DEMO_SESSION_WRITE_LIMIT=100
DEMO_DAILY_WRITE_LIMIT=1000

# Gmail OAuth client secrets stay server-side. See docs/GMAIL_SETUP.md.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_TOKEN_ENCRYPTION_KEY=
GMAIL_REDIRECT_URI=http://localhost:5000/api/gmail/callback
GMAIL_POLL_SECONDS=60

# Used only by the scheduler that calls POST /api/jobs/reminders.
JOB_KEY=replace-with-a-second-long-random-secret
